# ============================================================================
# Ticketing System — environment variables
# Copy this file to `.env` (`cp .env.example .env`) before `docker compose up`.
# The values below are Docker-Compose-ready defaults for local development.
# ============================================================================

# ---------------------------------------------------------------------------
# ESSENTIAL — the app will not run correctly without these
# ---------------------------------------------------------------------------

# Django settings module. MUST be set: the default `config.settings` resolves to
# an empty package, so point it at the development (or production) settings.
DJANGO_SETTINGS_MODULE=config.settings.development

# Django secret key (session/CSRF/JWT signing). CHANGE THIS in any real
# deployment. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-insecure-secret-key-for-local-only

# PostgreSQL connection. Host `db` is the Docker Compose service name.
# Password must match POSTGRES_PASSWORD below.
DATABASE_URL=postgres://ticketing:devpassword@db:5432/ticketing
POSTGRES_PASSWORD=devpassword

# Redis connection (cache + Celery broker/result backend). Host `redis` is the
# Docker Compose service name.
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# RECOMMENDED
# ---------------------------------------------------------------------------

# Debug mode. Keep True for local dev; MUST be False in production.
DEBUG=True

# Comma-separated allowed hosts (development settings already allow '*').
ALLOWED_HOSTS=localhost,127.0.0.1

# HMAC secret that signs QR ticket fingerprints. Anyone with this value can
# forge tickets — set a strong unique value outside local dev.
QR_SECRET=dev-qr-secret

# ---------------------------------------------------------------------------
# OPTIONAL — payment providers & integrations (leave blank to disable)
# ---------------------------------------------------------------------------

# LemonSqueezy
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LS_STORE_ID=

# M-Pesa (Safaricom Daraja)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_SANDBOX=True

# Sentry error tracking (leave blank to disable)
SENTRY_DSN=
