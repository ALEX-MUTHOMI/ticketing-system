# Development-only environment variables for the Cloud Agent environment.
# These are non-secret local defaults. Real secrets must come from the
# Secrets panel, never from this committed file.
#
# NOTE: manage.py defaults DJANGO_SETTINGS_MODULE to `config.settings`, which
# resolves to the (empty) `config/settings/` package, so it MUST be set to the
# development settings module here. django-environ in this project never calls
# read_env(), so configuration is supplied via real environment variables.
export DJANGO_SETTINGS_MODULE=config.settings.development
export DATABASE_URL=postgres://ticketing:devpassword@localhost:5432/ticketing
export REDIS_URL=redis://localhost:6379/0
export SECRET_KEY=dev-insecure-secret-key-for-local-only
export QR_SECRET=dev-qr-secret
export ALLOWED_HOSTS=localhost,127.0.0.1
export PATH="$HOME/.local/bin:$PATH"
